  "cards": [
    {
      "dot": "rose",
      "title": "Ingress & Edge Shielding",
      "items": [
        "Port 8000 ingress bounded by PayloadShield middleware enforcing 10MB limit with canonical HTTP 413 error envelopes",
        "TrustedProxyChecker validates client IP against configured CIDR masks, stripping forged proxy headers from untrusted origins",
        "Radix Trie router resolves incoming route paths in <1ms with zero memory allocations per request"
      ]
    },
    {
      "dot": "cyan",
      "title": "Pipeline & Inbound Authentication",
      "items": [
        "Multi-plugin authentication engine evaluates key-auth, jwt-auth, basic-auth, oauth2, and hmac-auth with configurable logical OR fallback",
        "Consumer-level and route-level token bucket rate limiters reject abusive traffic before upstream dispatch",
        "Contextual consumer identity and group attributes injected into pipeline for downstream policy enforcement"
      ]
    },
    {
      "dot": "emerald",
      "title": "Upstream Routing & Instant CRUD",
      "items": [
        "Passive circuit breakers track consecutive 5xx failures and automatically trip targets to prevent cascading downtime",
        "Outbound credential injector attaches Bearer tokens, Basic auth, API keys, AWS SigV4, or OAuth2 Client Credentials to upstream requests",
        "Instant CRUD engine dynamically transforms REST calls into PostgreSQL, MySQL, and SQLite queries with introspection schema mapping",
        "SSH Bastion Tunnel adapter establishes encrypted jump-host tunnels for private backend databases"
      ]
    },
    {
      "dot": "amber",
      "title": "Control Plane & Zero-Downtime Synchronization",
      "items": [
        "Dedicated port separation isolates Data Plane (:8000), Admin API (:8001), Web Console (:8002), and Health/Metrics (:8100)",
        "Admin server exposes RBAC endpoints with automatic redaction of sensitive credentials and database connection secrets",
        "Distributed Redis Pub/Sub topic apirout:events broadcasts schema and routing updates across cluster nodes for atomic pointer swapping"
      ]
    },
    {
      "dot": "violet",
      "title": "Observability & Telemetry",
      "items": [
        "Telemetry stage exports Prometheus runtime metrics on :8100 (/metrics) and reports Kubernetes liveness/readiness probes (/health)",
        "Correlation IDs (X-Request-ID) propagated end-to-end through pipeline context to access loggers and upstream headers",
        "High-performance structured JSON access logging records upstream latency, gateway latency, status codes, and bytes transferred"
      ]
    }
  ]
}
